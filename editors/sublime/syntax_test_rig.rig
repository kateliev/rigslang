; SYNTAX TEST "Packages/Rig/Rig.sublime-syntax"
; Run in Sublime Text: open this file, then Tools > Build.

unit sort-tool  ; a comment
; <- storage.type.unit.rig
;    ^^^^^^^^^ entity.name.type.unit.rig
;               ^^^^^^^^^^^ comment.line.semicolon.rig
  note "keep the hyphens"
; ^^^^ keyword.other.context.rig
;      ^^^^^^^^^^^^^^^^^^ string.quoted.double.rig
  intent "say \"hi\"; not a comment"
; ^^^^^^ keyword.other.matrix.rig
;        ^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double.rig
;             ^^ constant.character.escape.rig
;                   ^^^^^ - comment
    never "write without approval" -> ok
;   ^^^^^ keyword.other.matrix.rig
;                                  ^^ keyword.operator.arrow.rig
;                                     ^^ variable.function.target.rig
  in text str
; ^^ keyword.other.matrix.rig
;    ^^^^ variable.parameter.input.rig
;         ^^^ support.type.rig
  out {id: int, folder?: str}
; ^^^ keyword.other.matrix.rig
;     ^ punctuation.section.braces.begin.rig
;        ^ punctuation.separator.key-value.rig
;          ^^^ support.type.rig
;             ^ punctuation.separator.comma.rig
;                     ^ keyword.operator.optional.rig
;                        ^^^ support.type.rig
;                           ^ punctuation.section.braces.end.rig
  code steps steps.py
; ^^^^ keyword.other.context.rig
    test tests/test_steps.py
;   ^^^^ keyword.other.context.rig
  rule sort.batch 60 "Bookmarks in one batch"
; ^^^^ storage.type.rule.rig
;      ^^^^^^^^^^ entity.name.constant.rule.rig
;                 ^^ constant.numeric.rig
;                    ^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double.rig
    range 10 100
;   ^^^^^ keyword.other.context.rig
;         ^^ constant.numeric.rig
  rule sort.bounds (0.5, 2.0) "Scale bounds"
;                  ^ punctuation.section.parens.begin.rig
;                   ^^^ constant.numeric.rig
;                      ^ punctuation.separator.comma.rig
;                        ^^^ constant.numeric.rig
;                           ^ punctuation.section.parens.end.rig
  rule sort.tags ["utm_", "fbclid"] "Tags"
;                ^ punctuation.section.brackets.begin.rig
;                 ^^^^^^ string.quoted.double.rig
;                       ^ punctuation.separator.comma.rig
;                                 ^ punctuation.section.brackets.end.rig
  rule sort.weights {fast: 10, careful: 30} "Weights"
;                   ^ punctuation.section.braces.begin.rig
;                        ^ punctuation.separator.key-value.rig
;                          ^^ constant.numeric.rig
;                            ^ punctuation.separator.comma.rig
;                                       ^^ constant.numeric.rig
;                                         ^ punctuation.section.braces.end.rig
  rule sort.mode fast "Mode"
    options fast | careful
;   ^^^^^^^ keyword.other.context.rig
;                ^ punctuation.separator.rig
  rule names.pattern /^[a-z]+$/ "Names"
;                    ^^^^^^^^^^ string.regexp.rig
  preset quick
; ^^^^^^ storage.type.rule.rig
;        ^^^^^ entity.name.constant.preset.rig
    set sort.batch 20
;   ^^^ keyword.other.context.rig
;       ^^^^^^^^^^ variable.other.constant.rule.rig

  step read "Read" by steps.read
; ^^^^ storage.type.node.rig
;      ^^^^ entity.name.function.node.rig
;                  ^^ keyword.control.flow.rig
    do "read the file, at most {sort.batch} and {sort.weights.fast} at a time"
;   ^^ keyword.control.flow.rig
;                              ^^^^^^^^^^^^ variable.other.constant.rule.rig
;                                               ^^^^^^^^^^^^^^^^^^^ variable.other.constant.rule.rig
    reads sort.batch sort.mode
;   ^^^^^ keyword.control.flow.rig
;         ^^^^^^^^^^ variable.other.constant.rule.rig
;                    ^^^^^^^^^ variable.other.constant.rule.rig
  gate ok hard "Read well" fail -> held "why"
; ^^^^ storage.type.node.rig
;      ^^ entity.name.function.node.rig
;         ^^^^ storage.modifier.gate.rig
;                          ^^^^ keyword.control.flow.rig
;                               ^^ keyword.operator.arrow.rig
;                                  ^^^^ variable.function.target.rig
    by gates.ok
;   ^^ keyword.control.flow.rig
;      ^^^^^^^^ support.function.rig
  for batch in read.batches
; ^^^ keyword.control.block.rig
;     ^^^^^ variable.other.item.rig
;           ^^ keyword.control.block.rig
;              ^^^^^^^^^^^^ variable.other.path.rig
    tolerate 20%
;   ^^^^^^^^ keyword.control.flow.rig
;            ^^^ constant.numeric.rig
    step sort by model
      out list[{id: int, folder?: str}]
;     ^^^ keyword.other.matrix.rig
;         ^^^^ support.type.rig
      timeout 5m
;     ^^^^^^^ keyword.control.flow.rig
;             ^^ constant.numeric.rig
      sees batch
;     ^^^^ keyword.control.flow.rig
    gate sort-ok hard
      retry 2
;     ^^^^^ keyword.control.flow.rig
      fail -> continue
;     ^^^^ keyword.control.flow.rig
  if sort.new
; ^^ keyword.control.block.rig
;    ^^^^^^^^ variable.other.path.rig
    gate new-ok human "Make these folders?"
;               ^^^^^ storage.modifier.gate.rig
  else
; ^^^^ keyword.control.block.rig
    gate tone model
;             ^^^^^ storage.modifier.gate.rig
      fail -> held
  until draft.done
; ^^^^^ keyword.control.block.rig
    retry 3
    step draft by model
  section "Output"
; ^^^^^^^ keyword.control.block.rig
    step report by steps.report
  end held "Held back"
; ^^^ storage.type.node.rig
;     ^^^^ entity.name.function.node.rig
  rollback
; ^^^^^^^^ keyword.control.block.rig
    step undo by steps.undo
;                ^^^^^^^^^^ support.function.rig
  finally
; ^^^^^^^ keyword.control.block.rig
    step summary by steps.summary

; >>> level 3
; <- comment.line.semicolon.rig
; ^^^^^^^^^^^ keyword.control.directive.rig
unit v2-features
  intent "check v2.1 constructs"
    audience "operators"
;   ^^^^^^^^ keyword.other.matrix.rig
    style "concise"
;   ^^^^^ keyword.other.matrix.rig
  code inspect src/inspect.py
; ^^^^ keyword.other.context.rig
;      ^^^^^^^ entity.name.namespace.rig
;              ^^^^^^^^^^^^^^ string.unquoted.path.rig
  queue "Pending" by inspect.pending
; ^^^^^ keyword.other.context.rig
;                 ^^ keyword.control.flow.rig
;                    ^^^^^^^^^^^^^^^ support.function.rig
  rules "rules.json"
; ^^^^^ storage.type.rule.rig
;       ^^^^^^^^^^^^ string.quoted.double.rig
  rules size
; ^^^^^ storage.type.rule.rig
;       ^^^^ entity.name.constant.rule.rig
    limit 1000 1..100000 "Longest text"
;   ^^^^^ entity.name.constant.rule.rig
;         ^^^^ constant.numeric.rig
;              ^ constant.numeric.rig
;               ^^ keyword.operator.range.rig
;                 ^^^^^^ constant.numeric.rig
      ui slider
;     ^^ keyword.other.context.rig
;        ^^^^^^ storage.modifier.ui.rig
    tiers {short: 200, standard: 1000} 1.._ "Tier limits"
;   ^^^^^ entity.name.constant.rule.rig
;          ^^^^^ variable.other.member.rig
;                                      ^ constant.numeric.rig
;                                       ^^ keyword.operator.range.rig
;                                         ^ constant.language.rig
    mode fast "Mode inside rules block stays a rule name"
;   ^^^^ entity.name.constant.rule.rig
      options fast | careful | off
;                              ^^^ constant.language.rig
  step fill by model
;           ^^ keyword.control.flow.rig
;              ^^^^^ storage.modifier.lane.rig
    reads size.*
;         ^^^^^^ variable.other.constant.rule.rig
    brief summary count
;   ^^^^^ keyword.control.flow.rig
;         ^^^^^^^ variable.other.path.rig
    out {label: str, score?: float | None}
;        ^^^^^ variable.other.member.rig
;               ^^^ support.type.rig
;                    ^^^^^ variable.other.member.rig
;                         ^ keyword.operator.optional.rig
;                            ^^^^^ support.type.rig
;                                  ^ punctuation.separator.rig
;                                    ^^^^ constant.language.rig
  reason plan "Propose options"
; ^^^^^^ storage.type.node.rig
;        ^^^^ entity.name.function.node.rig
    mode creative
;   ^^^^ keyword.control.flow.rig
;        ^^^^^^^^ storage.modifier.mode.rig
    tools inspect.read inspect.measure
;   ^^^^^ keyword.control.flow.rig
;         ^^^^^^^^^^^^ support.function.rig
;                      ^^^^^^^^^^^^^^^ support.function.rig
    budget 4
;   ^^^^^^ keyword.control.flow.rig
;          ^ constant.numeric.rig
    candidates size.limit
;   ^^^^^^^^^^ keyword.control.flow.rig
;              ^^^^^^^^^^ variable.other.constant.rule.rig
    sees text fill.label
;   ^^^^ keyword.control.flow.rig
;        ^^^^ variable.other.path.rig
;             ^^^^^^^^^^ variable.other.path.rig
    out list[str]
  for item in plan
    gate check-item hard
      retry size.limit
;     ^^^^^ keyword.control.flow.rig
;           ^^^^^^^^^^ variable.other.constant.rule.rig
      fail -> continue
;          ^^ keyword.operator.arrow.rig
;             ^^^^^^^^ keyword.control.flow.rig
  ensure "removed v0 words are not keywords"
; ^^^^^^ - keyword
; ^^^^^^ - storage
; <<< level 3
