{
	"comments": {
		"lineComment": ";"
	},
	"brackets": [
		["(", ")"],
		["[", "]"],
		["{", "}"]
	],
	"autoClosingPairs": [
		{ "open": "(", "close": ")" },
		{ "open": "[", "close": "]" },
		{ "open": "{", "close": "}" },
		{ "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
	],
	"surroundingPairs": [
		["(", ")"],
		["[", "]"],
		["{", "}"],
		["\"", "\""]
	],
	"folding": {
		"offSide": true
	},
	"wordPattern": "[^\\s()\\[\\]{},:?|\";]+",
	"indentationRules": {
		"increaseIndentPattern": "^\\s*(unit|intent|rule|rules(?!\\s*\")|step|reason|gate|queue|note|code|preset|for|until|if|else|section|rollback|finally)\\b.*$",
		"decreaseIndentPattern": "^\\s*$"
	}
}
