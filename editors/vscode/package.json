{
	"name": "rig-language",
	"displayName": "Rig",
	"description": "Syntax highlighting for Rig v2 (.rig) files: reason, intent, rules, flows and gates.",
	"version": "2.1.0",
	"publisher": "riglang",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/kateliev/riglang"
	},
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "rig",
				"aliases": [
					"Rig",
					"rig"
				],
				"extensions": [
					".rig"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "rig",
				"scopeName": "source.rig",
				"path": "./syntaxes/rig.tmLanguage.json"
			}
		],
		"configurationDefaults": {
			"[rig]": {
				"editor.tabSize": 2,
				"editor.insertSpaces": true,
				"editor.detectIndentation": false
			}
		}
	}
}
