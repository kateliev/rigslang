					"name": "variable.other.constant.rule.rig"
				}
			]
		},
		"comment": {
			"match": ";.*$",
			"name": "comment.line.semicolon.rig"
		},
		"regex": {
			"match": "(?<![^\\s(])/(?:\\\\.|[^/\\\\])*/(?=[\\s)]|$)",
			"name": "string.regexp.rig"
		},
		"arrow": {
			"match": "(?<![^\\s(])(->)(?:\\s+([^\\s();\"][^\\s();]*))?",
			"captures": {
