			"match": "(?<![^\\s(])(?:on|off|true|false)(?=[\\s();]|$)",
			"name": "constant.language.rig"
		},
		"unknown": {
			"match": "(?<![^\\s(])\\?(?=[\\s();]|$)",
			"name": "constant.language.unknown.rig"
