				}
			}
		},
		"example": {
			"match": "(?<![^\\s(])=>(?=[\\s();]|$)",
			"name": "keyword.operator.arrow.rig"
		},
		"inline": {
			"match": "(?<![^\\s(])(?:by|fail)(?=[\\s();]|$)",
			"name": "keyword.control.flow.rig"
		},
		"percent": {
			"match": "(?<![^\\s(])\\d+(?:\\.\\d+)?%(?=[\\s();]|$)",
			"name": "constant.numeric.rig"
		},
		"time": {
			"match": "(?<![^\\s(])\\d+[smhd](?=[\\s();]|$)",
			"name": "constant.numeric.rig"
		},
		"bar": {
			"match": "(?<![^\\s(])\\|(?=[\\s();]|$)",
			"name": "punctuation.separator.rig"
		},
		"number": {
			"match": "(?<![^\\s(])[-+]?\\d+(?:\\.\\d+)?(?=[\\s();]|$)",
			"name": "constant.numeric.rig"
		},
		"constant": {
			"match": "(?<![^\\s(])(?:on|off|true|false)(?=[\\s();]|$)",
			"name": "constant.language.rig"
		},
		"paren-open": {
			"match": "\\(",
			"name": "punctuation.section.parens.begin.rig"
		},
		"paren-close": {
			"match": "\\)",
