; A complete small tool, built with the kit. It checks a release folder and publishes it.
; Code does the steps and decides the hard and soft gates (gates.py, steps.py).
; The model decides one gate (tone) and does one step (rewrite), at most notes.rounds times. A person decides one gate (approve).
; Build: python3 ../../skills/rig/rig.py build .     Run: python3 tool.py run '{"folder": "tests/cases/good"}'

unit release agent
  intent "publish a release folder only when its notes, its version and its tests are ready, and a person agrees"
  in folder path "the release folder: it holds NOTES.md, VERSION and tests.json"
  out text "the end of the run: published, ready (dry run) or stopped, with the problems"
  code gates gates.py
    test tests/test_gates.py
  code steps steps.py
    test tests/test_steps.py

  rule notes.min_words 50 "Shortest release notes, in words"
    range 10 500
    note "shorter notes did not answer the usual questions"
  rule notes.rounds 2 "Most rewrites of the notes"
    range 0 5
    note "a third rewrite did not pass where two had failed; the person then writes the notes"
  rule version.pattern /^\d+\.\d+\.\d+$/ "Version format"
  rule tests.required on "Tests must pass"
  rule permissions.publish off "The tool may publish"
    note "off: a dry run. The run ends at ready and changes nothing."
  preset hotfix
    set notes.min_words 10
    set notes.rounds 0

  ; The lines run in order. A gate that passes goes on to the next line; a fail goes to an end.
  step collect "Collect" by steps.collect
    do "read NOTES.md, VERSION and tests.json of the folder"
  gate notes hard "Notes long enough"
    check "the notes have at least {notes.min_words} words"
    by gates.notes_ok
    fail -> stop "notes too short"
  gate version hard "Version format"
    check "the version matches {version.pattern}"
    by gates.version_ok
    fail -> stop "bad version"
  gate tests-required hard "Tests green when they are required"
    reads tests.required
    check "the last test run passed, or the rule tests.required is off"
    by gates.tests_required
    fail -> stop "tests failed and tests are required"
  gate tests soft "Tests green"
    check "the last test run passed; a fail is reported"
    by gates.tests_green
  step rewrite "Rewrite the notes" by model
    if tone.failed
    do "rewrite the notes for users: plain words, and the upgrade steps; give the new text as the result"
    sees collect.notes rewrite tone
    out text
  gate rewritten hard "The rewrite is long enough"
    if rewrite
    check "the rewritten notes have at least {notes.min_words} words"
    by gates.notes_ok
    fail -> stop "the rewrite is too short"
  gate tone model "Notes speak to users"
    check "read the notes as a user would; fail if they use internal words or miss the upgrade steps"
    sees collect.notes rewrite
    retry notes.rounds
    fail -> stop "the notes do not speak to users"
  gate approve human "May this release be published?"
    check "show the person the version and the notes"
    sees collect.version collect.notes rewrite
    fail -> stop "the person said no"
  gate allowed hard "The tool may publish"
    reads permissions.publish
    check "the rule permissions.publish is on"
    by gates.may_publish
    fail -> ready "dry run"
  step publish "Publish" by steps.publish
    do "write published.json into the folder"
  end done "Published"
  end ready "Ready, not published"
  end stop "Stopped"
