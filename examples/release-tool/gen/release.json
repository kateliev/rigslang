{
 "rig": 2,
 "unit": "release",
 "preset": null,
 "intent": "publish a release folder only when its notes, its version and its tests are ready, and a person agrees",
 "notes": [],
 "code": [
  {
   "prefix": "gates",
   "file": "gates.py",
   "test": "tests/test_gates.py"
  },
  {
   "prefix": "steps",
   "file": "steps.py",
   "test": "tests/test_steps.py"
  }
 ],
 "in": [
  {
   "name": "folder",
   "type": "path",
   "text": "the release folder: it holds NOTES.md, VERSION and tests.json",
   "schema": {
    "type": "string"
   }
  }
 ],
 "out": {
  "type": "text",
  "text": "the end of the run: published, ready (dry run) or stopped, with the problems",
  "schema": {
   "type": "string"
  }
 },
 "start": "collect",
 "rollback": null,
 "finally": null,
 "body": [
  "collect",
  "notes",
  "version",
  "tests-required",
  "tests",
  "rewrite",
  "rewritten",
  "tone",
  "approve",
  "allowed",
  "publish",
  "done",
  "ready",
  "stop"
 ],
 "coverage": {
  "gates": 8,
  "tested": 6,
  "code": 0,
  "model": 1,
  "human": 1,
  "none": 0
 },
 "presets": {
  "hotfix": {
   "notes.min_words": 10,
   "notes.rounds": 0
  }
 },
 "rules": [
  {
   "id": "notes.min_words",
   "group": "notes",
   "label": "Shortest release notes, in words",
   "type": "number",
   "value": 50,
   "default": 50,
   "min": 10,
   "max": 500,
   "note": "shorter notes did not answer the usual questions"
  },
  {
   "id": "notes.rounds",
   "group": "notes",
   "label": "Most rewrites of the notes",
   "type": "number",
   "value": 2,
   "default": 2,
   "min": 0,
   "max": 5,
   "note": "a third rewrite did not pass where two had failed; the person then writes the notes"
  },
  {
   "id": "version.pattern",
   "group": "version",
   "label": "Version format",
   "type": "pattern",
   "value": "^\\d+\\.\\d+\\.\\d+$",
   "default": "^\\d+\\.\\d+\\.\\d+$"
  },
  {
   "id": "tests.required",
   "group": "tests",
   "label": "Tests must pass",
   "type": "switch",
   "value": true,
   "default": true,
   "ui": "toggle"
  },
  {
   "id": "permissions.publish",
   "group": "permissions",
   "label": "The tool may publish",
   "type": "switch",
   "value": false,
   "default": false,
   "ui": "toggle",
   "note": "off: a dry run. The run ends at ready and changes nothing."
  }
 ],
 "flow": [
  {
   "id": "collect",
   "kind": "step",
   "lane": "code",
   "name": "Collect",
   "do": "read NOTES.md, VERSION and tests.json of the folder",
   "by": [
    "steps.collect"
   ],
   "next": "notes"
  },
  {
   "id": "notes",
   "kind": "hard",
   "lane": "code",
   "name": "Notes long enough",
   "check": "the notes have at least {notes.min_words} words",
   "by": [
    "gates.notes_ok"
   ],
   "reads": [
    "notes.min_words"
   ],
   "fail": [
    {
     "to": "stop",
     "when": "notes too short"
    }
   ],
   "next": "version"
  },
  {
   "id": "version",
   "kind": "hard",
   "lane": "code",
   "name": "Version format",
   "check": "the version matches {version.pattern}",
   "by": [
    "gates.version_ok"
   ],
   "reads": [
    "version.pattern"
   ],
   "fail": [
    {
     "to": "stop",
     "when": "bad version"
    }
   ],
   "next": "tests-required"
  },
  {
   "id": "tests-required",
   "kind": "hard",
   "lane": "code",
   "name": "Tests green when they are required",
   "check": "the last test run passed, or the rule tests.required is off",
   "by": [
    "gates.tests_required"
   ],
   "reads": [
    "tests.required"
   ],
   "fail": [
    {
     "to": "stop",
     "when": "tests failed and tests are required"
    }
   ],
   "next": "tests"
  },
  {
   "id": "tests",
   "kind": "soft",
   "lane": "code",
   "name": "Tests green",
   "check": "the last test run passed; a fail is reported",
   "by": [
    "gates.tests_green"
   ],
   "next": "rewrite"
  },
  {
   "id": "rewrite",
   "kind": "step",
   "lane": "model",
   "name": "Rewrite the notes",
   "do": "rewrite the notes for users: plain words, and the upgrade steps; give the new text as the result",
   "sees": [
    "collect.notes",
    "rewrite",
    "tone"
   ],
   "out": "text",
   "schema": {
    "type": "string"
   },
   "if": "tone.failed",
   "next": "rewritten"
  },
  {
   "id": "rewritten",
   "kind": "hard",
   "lane": "code",
   "name": "The rewrite is long enough",
   "check": "the rewritten notes have at least {notes.min_words} words",
   "by": [
    "gates.notes_ok"
   ],
   "reads": [
    "notes.min_words"
   ],
   "if": "rewrite",
   "fail": [
    {
     "to": "stop",
     "when": "the rewrite is too short"
    }
   ],
   "next": "tone"
  },
  {
   "id": "tone",
   "kind": "model",
   "lane": "model",
   "name": "Notes speak to users",
   "check": "read the notes as a user would; fail if they use internal words or miss the upgrade steps",
   "reads": [
    "notes.rounds"
   ],
   "sees": [
    "collect.notes",
    "rewrite"
   ],
   "retry": "notes.rounds",
   "fail": [
    {
     "to": "stop",
     "when": "the notes do not speak to users"
    }
   ],
   "next": "approve",
   "back": "rewrite"
  },
  {
   "id": "approve",
   "kind": "human",
   "lane": "person",
   "name": "May this release be published?",
   "check": "show the person the version and the notes",
   "sees": [
    "collect.version",
    "collect.notes",
    "rewrite"
   ],
   "fail": [
    {
     "to": "stop",
     "when": "the person said no"
    }
   ],
   "next": "allowed"
  },
  {
   "id": "allowed",
   "kind": "hard",
   "lane": "code",
   "name": "The tool may publish",
   "check": "the rule permissions.publish is on",
   "by": [
    "gates.may_publish"
   ],
   "reads": [
    "permissions.publish"
   ],
   "fail": [
    {
     "to": "ready",
     "when": "dry run"
    }
   ],
   "next": "publish"
  },
  {
   "id": "publish",
   "kind": "step",
   "lane": "code",
   "name": "Publish",
   "do": "write published.json into the folder",
   "by": [
    "steps.publish"
   ],
   "reads": [
    "permissions.publish"
   ],
   "next": "done"
  },
  {
   "id": "done",
   "kind": "end",
   "lane": "end",
   "name": "Published"
  },
  {
   "id": "ready",
   "kind": "end",
   "lane": "end",
   "name": "Ready, not published"
  },
  {
   "id": "stop",
   "kind": "end",
   "lane": "end",
   "name": "Stopped"
  }
 ],
 "blocks": [],
 "intent_spec": {
  "text": "publish a release folder only when its notes, its version and its tests are ready, and a person agrees",
  "audience": "end users upgrading the product",
  "style": "plain language with clear upgrade steps",
  "never": [
   {
    "text": "publish without human approval",
    "gate": "approve"
   },
   {
    "text": "publish when permissions.publish is off",
    "gate": "allowed"
   }
  ]
 }
}
