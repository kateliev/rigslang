; An agent for a local model in LM Studio. The model follows this unit:
; compile it to a skill and use the skill as the system prompt.
; The model calls two tools: search (search.rig) and wiki (wiki.rig).

unit bandsearch agent
  intent "for a band name, write one paragraph about the band and list its albums; take the facts from English Wikipedia; find the article with a web search"
  uses search search.rig
  uses wiki wiki.rig
  in band str "the name of the band"
  out text "one paragraph, the albums as title (year), and the article URL"

  rule answer.max_words 120
    min 40
    max 300
    label "Longest paragraph"
  rule albums.max 25
    min 1
    max 100
    label "Most albums in the list"

  step find "Find the article"
    do "call search with the band name and the word band; take the first result whose URL is on en.wikipedia.org"
    by search
    next -> read
  step read "Read the article"
    do "call wiki with the URL of that result"
    by wiki
    next -> found
  gate found hard "Article read"
    ensure "wiki ended at done and gave a summary"
    by wiki
    pass -> is-band
    fail -> stop "no Wikipedia article"
  gate is-band judge "The article is about the band"
    brief "read the summary; pass if it describes a music group with this name; fail if it is about a person, a place, a film or another group"
    note "candidate for code: the short description of the article often has the word band"
    pass -> albums
    fail -> stop "the article is not about the band"
  gate albums soft "Albums found"
    ensure "wiki gave at least one album"
    by wiki
    pass -> write
    fail -> write "say that the article lists no albums"
  step write "Write"
    do "write one paragraph of at most {answer.max_words} words from the summary only; then list at most {albums.max} albums as title (year); end with the article URL"
    next -> grounded
  gate grounded judge "Only facts from the article"
    brief "compare the paragraph with the summary; fail if the paragraph states a fact that the summary does not have"
    pass -> done
    fail -> write "remove the facts that are not in the summary"
  end done "Answered"
  end stop "Stopped"
