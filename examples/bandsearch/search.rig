; Tool: web search with DuckDuckGo. It needs no API key: it reads the HTML results page.
; The cast needs the network, so it has probes and no examples: its stamp is "observed".
; It imports ddg-results (proved) and its own rule values from search.json.

unit search tool
  intent "search the web with DuckDuckGo; give back the first {results.max} results as title and URL"
  uses ddg-results
  in query str "the words to search for"
  out (record end (one-of done error) reason (maybe str) results (list (tuple str str))) "end is done or error; results as [title, url]"
  ensure "each URL starts with http"
    check py "all(u.startswith('http') for t, u in result['results'])"

  rule results.max 5
    min 1
    max 20
    label "Most results"
  rule http.timeout 10
    min 1
    max 60
    unit "seconds"
    label "Time to wait for the page"

  step fetch "Fetch"
    do "GET html.duckduckgo.com/html/ with the query as q; stop after {http.timeout} seconds"
    by search
    next -> ok
  gate ok hard "Page received"
    ensure "the status is OK and the body is HTML"
    by search
    pass -> parse
    fail -> error "blocked or offline"
  step parse "Read the results"
    do "take the first {results.max} results with ddg-results"
    by ddg-results
    next -> any
  gate any soft "Results found"
    ensure "the list is not empty"
    by search
    pass -> done
    fail -> done "give back an empty list"
  end done "Results"
  end error "Search failed"

  probe "Pink Floyd band"
    check py "result['end'] == 'done' and any(u == 'https://en.wikipedia.org/wiki/Pink_Floyd' for t, u in result['results'])"
  cast ts #5182fe1b #dadd8677 observed 2026-11-12
    import catalogue from "./search.json" with { type: "json" };
    import { ddg_results } from "./ddg-results.ts";

    const rule: Record<string, any> = Object.fromEntries(catalogue.rules.map((r) => [r.id, r.value]));

    type Out = { end: "done" | "error"; reason?: string; results: [string, string][] };

    export async function search(query: string): Promise<Out> {
      // step fetch
      let res: Response;
      try {
        res = await fetch("https://html.duckduckgo.com/html/?q=" + encodeURIComponent(query), {
          signal: AbortSignal.timeout(rule["http.timeout"] * 1000),
          headers: { "User-Agent": "bandsearch-example/0.1" },
        });
      } catch {
        return { end: "error", reason: "blocked or offline", results: [] };
      }
      // gate ok (hard)
      if (!res.ok || !(res.headers.get("content-type") ?? "").includes("text/html")) {
        return { end: "error", reason: "blocked or offline", results: [] };
      }
      // step parse
      const results = ddg_results(await res.text(), rule["results.max"]);
      // gate any (soft): an empty list is reported, and the flow ends at done
      if (results.length === 0) return { end: "done", reason: "give back an empty list", results };
      return { end: "done", results };
    }

unit ddg-results snippet
  intent "read a DuckDuckGo HTML results page; give back each result as (title url), in page order, at most limit results; change a redirect link to the URL it points to; remove HTML tags and entities from the title"
  in html str
  in limit int
  out list
  example "<a class=\"result__a\" href=\"//duckduckgo.com/l/?uddg=https%3A%2F%2Fen.wikipedia.org%2Fwiki%2FPink_Floyd&amp;rut=x\">Pink <b>Floyd</b> - Wikipedia</a>" 5 => (("Pink Floyd - Wikipedia" "https://en.wikipedia.org/wiki/Pink_Floyd"))
  example "<a class=\"result__a\" href=\"https://a.example/\">A &amp; B</a><a class=\"result__a\" href=\"https://b.example/\">C</a>" 1 => (("A & B" "https://a.example/"))
  example "<html>no results</html>" 5 => ()
  ensure "the list has at most limit results"
    check py "len(result) <= limit"
  ensure "each URL starts with http"
    check py "all(u.startswith('http') for t, u in result)"
  note "the results page is not a public API; if DuckDuckGo changes its markup, these examples still pass but real searches give nothing"
  cast ts #16d45ecd #1473dede proved 2026-11-12
    const ENTITIES: Record<string, string> = { amp: "&", lt: "<", gt: ">", quot: '"', "#39": "'", "#x27": "'", nbsp: " " };

    function decodeEntities(s: string): string {
      return s.replace(/&(#?\w+);/g, (m, e) => ENTITIES[e] ?? m);
    }

    export function ddg_results(html: string, limit: number): [string, string][] {
      const out: [string, string][] = [];
      for (const m of html.matchAll(/<a\b([^>]*)>([\s\S]*?)<\/a>/g)) {
        if (out.length >= limit) break;
        const attrs = m[1];
        if (!/class="[^"]*\bresult__a\b/.test(attrs)) continue;
        const href = attrs.match(/href="([^"]*)"/);
        if (!href) continue;
        let url = decodeEntities(href[1]);
        const redirect = url.match(/[?&]uddg=([^&]+)/);
        if (redirect) url = decodeURIComponent(redirect[1]);
        if (url.startsWith("//")) url = "https:" + url;
        if (!url.startsWith("http")) continue;
        const title = decodeEntities(m[2].replace(/<[^>]*>/g, "")).trim();
        out.push([title, url]);
      }
      return out;
    }
