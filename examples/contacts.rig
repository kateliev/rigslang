; A tool that uses a snippet. The snippet is still a hole: it has a matrix, no cast.

unit normalize-email snippet
  reason "the same person signs up twice with two spellings of one address"
  intent "remove spaces at both ends and make the address lowercase; change nothing else"
  in address str
  out str
  example "  Ana@Example.COM " => "ana@example.com"
  example "bo@x.io" => "bo@x.io"
  ensure "the result has no spaces at either end"
    check py "result == result.strip()"

unit dedupe-contacts tool
  reason ?
  intent "read a CSV of contacts; keep the first row of each email; write a new CSV"
  uses normalize-email
  in source path
  out path
  step read "Read"
    do "read the CSV; the first row is the header"
    next -> has-email
  gate has-email hard "Has an email column"
    ensure "the header has a column named email"
    by contacts.has_email
    pass -> keep
    fail -> stop "no email column"
  step keep "Keep first"
    do "normalize each email with normalize-email; keep the first row of each"
    next -> write
  step write "Write"
    do "write the kept rows to a new file next to the source"
    next -> done
  end done "Written"
  end stop "Stopped"
