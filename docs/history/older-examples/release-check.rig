; An agent: rules (parameters), presets, steps, and gates of all three kinds.
; A {group.name} in a text names a rule: the compilers write its value there.

unit release-check agent
  intent "publish a release only when the notes, the version and the tests are ready"
  external checks.notes_ok "count the words of the release notes"
  external checks.version_ok "match the version tag against the pattern"
  external checks.tests_green "read the result of the last test run"
  external release.publish "tag and publish the release"

  rule notes.min_words 50
    min 10
    max 500
    label "Shortest release notes"
    note "shorter notes did not answer the usual questions"
  rule version.pattern /^\d+\.\d+\.\d+$/
    label "Version format"
  rule tests.required on
    label "Tests must pass"
  preset hotfix
    set notes.min_words 10

  step collect "Collect"
    do "read the notes, the version tag and the last test run"
    next -> notes
  gate notes hard "Notes long enough"
    when "always"
    ensure "the notes have at least {notes.min_words} words"
    by checks.notes_ok
    pass -> version
    fail -> stop "notes too short"
  gate version hard "Version format"
    ensure "the version tag matches {version.pattern}"
    by checks.version_ok
    pass -> tests
    fail -> stop "bad version"
  gate tests soft "Tests green"
    reads tests.required
    ensure "the last test run passed"
    by checks.tests_green
    pass -> tone
    fail -> tone "report and continue"
  gate tone judge "Notes speak to users"
    brief "read the notes as a user would; flag internal words and missing upgrade steps"
    pass -> publish
    fail -> collect "rewrite the notes"
  step publish "Publish"
    do "tag and publish the release"
    by release.publish
    next -> done
  end done "Published"
  end stop "Stopped"
