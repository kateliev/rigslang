; Every line marked "error" must be refused by rig.py (see test_rig.py).

unit broken agent
  intent "uses {nope.missing} and {plain} text"     ; error: no rule nope.missing
  rule limits 3                                     ; error: an id is group.name
  rule size.max 12 "Size"                           ; error: above the range
    range 1 10
  rule mode.kind fast "Mode"
    options fast | slow
  rule flag.on maybe "Flag"                         ; error: not one of the options
    options on | off
  preset quick
    set size.max 99                                 ; error: above the range
    set mode.kind medium                            ; error: not an option
    set ghost.rule 1                                ; error: no such rule
  preset quick                                      ; error: twice
  step a "A" by model
    do "make 3 drafts, then {size.max} more"
  gate b hard "B"
    check "at most {size.max} and {mode.kind}"
    by checks.b
    fail -> a                                       ; error: a fail goes to an end
  end done "Done"
